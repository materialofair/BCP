# Copy to .env and adjust for your approved network route.
DATABASE_URL=sqlite:///./data/bcp.sqlite3
BCP_AUTH_REQUIRED=false
# Optional account file location; defaults to data/users.json.
# BCP_AUTH_USERS_FILE=data/users.json
SCAN_INTERVAL_HOURS=6
SCAN_JOB_LEASE_SECONDS=180
SCAN_REQUEST_BUDGET=100
SCAN_REQUEST_DELAY_SECONDS=1
GDELT_ENABLED=true
GDELT_MAX_RECORDS=20
GOOGLE_NEWS_ENABLED=true
# Comma-separated RSS/Atom feed URLs approved by your network team.
RSS_FEEDS=
# Optional HTTP(S) proxy. Leave empty if the host has a direct approved route.
HTTPS_PROXY=
HTTP_PROXY=
# Comma-separated approved outbound hostnames; include RSS hosts you configure.
OUTBOUND_ALLOWLIST=api.gdeltproject.org,news.google.com
